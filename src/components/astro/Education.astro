---
const es = {
  tag: 'FORMACIÓN',
  title: 'Educación académica',
  certificaciones: 'Certificaciones',
  continua: 'Formación continua',
  continuaDesc: 'Siempre aprendiendo nuevas tecnologías y mejores prácticas.',
  credencial: 'Credencial:',
};

const en = {
  tag: 'EDUCATION',
  title: 'Academic education',
  certificaciones: 'Certifications',
  continua: 'Continuous learning',
  continuaDesc: 'Always learning new technologies and best practices.',
  credencial: 'Credential:',
};

const degrees = [
  {
    title: 'Ingeniería de Sistemas',
    institution: 'Institución Universitaria del Putumayo',
    periodEs: 'En curso - 10º Semestre',
    periodEn: 'In progress - 10th Semester',
    descEs: 'Programación orientada a objetos (POO), Arquitectura de la información',
    descEn: 'Object-oriented programming, Information architecture',
  },
  {
    title: 'Tecnólogo en Desarrollo de Software',
    institution: 'Institución Universitaria del Putumayo',
    periodEs: '2021 - 2024',
    periodEn: '2021 - 2024',
    descEs: 'Informática, comunicaciones y servicios de asistencia',
    descEn: 'Computing, communications and support services',
  },
];

const certifications = [
  {
    title: 'Apropiación de conceptos de ciberseguridad',
    issuer: 'Servicio Nacional de Aprendizaje (SENA)',
    date: 'Mayo 2025',
    credential: '9209003184764CC1123321738C',
  },
];
---

<section id="education" class="py-24 relative">
  <div class="absolute inset-0 pattern-grid-accent opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex items-start gap-6 mb-12">
      <span class="section-number">06</span>
      <div>
        <p class="section-tag" data-lang-content="es">{es.tag}</p>
        <p class="section-tag" data-lang-content="en">{en.tag}</p>
        <h2 class="section-title" data-lang-content="es">{es.title}</h2>
        <h2 class="section-title" data-lang-content="en">{en.title}</h2>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="relative">
        <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-accent"></div>

        {degrees.map((degree) => (
          <div class="relative flex items-start mb-6 pl-12">
            <div class="absolute left-4 w-4 h-4 bg-accent transform -translate-x-1/2 z-10 border-2 border-background flex items-center justify-center">
              <div class="w-1.5 h-1.5 bg-background"></div>
            </div>

            <div class="brutal-card p-5 flex-1 group">
              <div class="font-display text-accent text-xs uppercase tracking-wider mb-2">
                <span data-lang-content="es">{degree.periodEs}</span>
                <span data-lang-content="en">{degree.periodEn}</span>
              </div>
              <h3 class="font-display text-lg font-bold text-text-primary mb-1 group-hover:text-accent transition-colors">{degree.title}</h3>
              <p class="font-display text-cyber text-sm uppercase tracking-wide mb-2">{degree.institution}</p>
              <p class="font-display text-text-muted text-xs uppercase tracking-wide">
                <span data-lang-content="es">{degree.descEs}</span>
                <span data-lang-content="en">{degree.descEn}</span>
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="space-y-6">
        <h3 class="font-display text-xl font-bold text-text-primary flex items-center gap-2 uppercase tracking-wider">
          <span class="w-3 h-3 bg-accent"></span>
          <span data-lang-content="es">{es.certificaciones}</span>
          <span data-lang-content="en">{en.certificaciones}</span>
        </h3>

        {certifications.map((cert) => (
          <div class="brutal-card p-5 group">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h4 class="font-display text-text-primary font-bold mb-1 group-hover:text-accent transition-colors text-sm uppercase tracking-wider">{cert.title}</h4>
                <p class="font-display text-text-muted text-xs uppercase tracking-wide">{cert.issuer}</p>
              </div>
              <span class="px-2 py-1 bg-accent/10 border-2 border-accent text-accent font-display text-xs uppercase tracking-wider whitespace-nowrap">
                {cert.date}
              </span>
            </div>
            <div class="mt-3 pt-3 border-t-2 border-border">
              <p class="font-display text-text-muted text-xs uppercase tracking-wide">
                <span data-lang-content="es">{es.credencial}</span>
                <span data-lang-content="en">{en.credencial}</span>
                <span class="text-text-secondary"> {cert.credential}</span>
              </p>
            </div>
          </div>
        ))}

        <div class="brutal-card p-5 border-accent">
          <h4 class="font-display text-text-primary font-bold mb-2 uppercase tracking-wider text-sm">
            <span data-lang-content="es">{es.continua}</span>
            <span data-lang-content="en">{en.continua}</span>
          </h4>
          <p class="font-display text-text-muted text-xs uppercase tracking-wide mb-3">
            <span data-lang-content="es">{es.continuaDesc}</span>
            <span data-lang-content="en">{en.continuaDesc}</span>
          </p>
          <div class="flex flex-wrap gap-2">
            {['JavaScript', 'TypeScript', 'React', 'Node.js', 'Astro'].map((tech) => (
              <span class="tech-badge text-xs">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
