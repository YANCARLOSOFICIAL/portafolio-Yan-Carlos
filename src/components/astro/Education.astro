---
import { siteConfig } from '../../config/siteConfig';
import { GraduationCap, Award, Calendar } from 'lucide-react';

const { education } = siteConfig;
---

<section id="education" class="py-24 relative">
  <div class="dot-pattern absolute inset-0 opacity-20 pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="mb-10">
      <p class="text-purple-400 text-sm font-mono tracking-wider uppercase mb-2">{education.tag}</p>
      <h2 class="text-3xl md:text-5xl font-extrabold text-white">{education.title}</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="relative">
        <div class="absolute left-4 top-0 bottom-0 w-px bg-gradient-to-b from-purple-500 via-purple-500/50 to-transparent"></div>

        {education.degrees.map((degree, index) => (
          <div class="relative flex items-start mb-6 pl-12">
            <div class="absolute left-2 w-5 h-5 bg-purple-500 rounded-full transform -translate-x-1/2 z-10 ring-4 ring-black flex items-center justify-center">
              <GraduationCap class="w-2.5 h-2.5 text-white" />
            </div>
            
            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5 flex-1 hover:border-purple-500/30 transition-colors group">
              <div class="flex items-center gap-2 text-purple-400 text-xs font-mono mb-2">
                <Calendar class="w-3 h-3" />
                {degree.period}
              </div>
              <h3 class="text-lg font-bold text-white mb-1 group-hover:text-purple-400 transition-colors">{degree.title}</h3>
              <p class="text-purple-300 text-sm mb-2">{degree.institution}</p>
              <p class="text-gray-400 text-sm">{degree.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="space-y-6">
        <h3 class="text-xl font-bold text-white flex items-center gap-2">
          <Award class="w-5 h-5 text-purple-400" />
          Certificaciones
        </h3>

        {education.certifications.map((cert, index) => (
          <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5 hover:border-purple-500/30 transition-colors group">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h4 class="text-white font-semibold mb-1 group-hover:text-purple-400 transition-colors">{cert.title}</h4>
                <p class="text-sm text-gray-400">{cert.issuer}</p>
              </div>
              <span class="px-2 py-1 bg-purple-500/20 text-purple-300 text-xs rounded-md font-mono border border-purple-500/30 whitespace-nowrap">
                {cert.date}
              </span>
            </div>
            <div class="mt-3 pt-3 border-t border-white/10">
              <p class="text-xs text-gray-500">Credencial: <span class="text-gray-400 font-mono">{cert.credential}</span></p>
            </div>
          </div>
        ))}

        <div class="bg-gradient-to-r from-purple-500/10 to-blue-500/10 border border-purple-500/20 rounded-xl p-5">
          <h4 class="text-white font-semibold mb-2">Formación continua</h4>
          <p class="text-sm text-gray-400">Siempre aprendiendo nuevas tecnologías y mejores prácticas de desarrollo.</p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="px-2 py-1 bg-white/5 text-gray-300 text-xs rounded-md">JavaScript</span>
            <span class="px-2 py-1 bg-white/5 text-gray-300 text-xs rounded-md">TypeScript</span>
            <span class="px-2 py-1 bg-white/5 text-gray-300 text-xs rounded-md">React</span>
            <span class="px-2 py-1 bg-white/5 text-gray-300 text-xs rounded-md">Node.js</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>