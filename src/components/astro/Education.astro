---
const degrees = [
  {
    title: 'Ingeniería de Sistemas',
    institution: 'Institución Universitaria del Putumayo',
    period: 'En curso - 10º Semestre',
    description: 'Programación orientada a objetos (POO), Arquitectura de la información',
  },
  {
    title: 'Tecnólogo en Desarrollo de Software',
    institution: 'Institución Universitaria del Putumayo',
    period: '2021 - 2024',
    description: 'Informática, comunicaciones y servicios de asistencia',
  },
];

const certifications = [
  {
    title: 'Apropiación de conceptos de ciberseguridad',
    issuer: 'Servicio Nacional de Aprendizaje (SENA)',
    date: 'Mayo 2025',
    credential: '9209003184764CC1123321738C',
  },
];
---

<section id="education" class="py-24 relative">
  <div class="absolute inset-0 pattern-dots opacity-30"></div>
  <div class="absolute top-0 right-1/4 w-64 h-64 bg-neon-pink/10 rounded-full blur-[100px]"></div>
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="mb-10">
      <p class="section-title">FORMACIÓN</p>
      <h2 class="section-heading">Educación académica</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="relative">
        <div class="absolute left-4 top-0 bottom-0 w-px bg-gradient-to-b from-neon-purple via-neon-purple/50 to-transparent"></div>

        {degrees.map((degree, index) => (
          <div class="relative flex items-start mb-6 pl-12">
            <div class="absolute left-2 w-5 h-5 bg-neon-purple rounded-full transform -translate-x-1/2 z-10 ring-4 ring-background flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
            </div>
            
            <div class="glass-hover rounded-xl p-5 flex-1 group">
              <div class="flex items-center gap-2 text-neon-purple text-xs font-mono mb-2">
                {degree.period}
              </div>
              <h3 class="text-lg font-bold text-white mb-1 group-hover:text-neon-purple transition-colors">{degree.title}</h3>
              <p class="text-neon-cyan text-sm mb-2">{degree.institution}</p>
              <p class="text-text-muted text-sm">{degree.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="space-y-6">
        <h3 class="text-xl font-bold text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-neon-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
          Certificaciones
        </h3>

        {certifications.map((cert) => (
          <div class="glass-hover rounded-xl p-5 group">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h4 class="text-white font-semibold mb-1 group-hover:text-neon-purple transition-colors">{cert.title}</h4>
                <p class="text-sm text-text-muted">{cert.issuer}</p>
              </div>
              <span class="px-2 py-1 bg-neon-purple/20 text-neon-purpleLight text-xs rounded-md font-mono border border-neon-purple/30 whitespace-nowrap">
                {cert.date}
              </span>
            </div>
            <div class="mt-3 pt-3 border-t border-white/5">
              <p class="text-xs text-text-muted">Credencial: <span class="text-text-secondary font-mono">{cert.credential}</span></p>
            </div>
          </div>
        ))}

        <div class="bg-gradient-to-r from-neon-purple/10 to-neon-cyan/10 border border-neon-purple/20 rounded-xl p-5">
          <h4 class="text-white font-semibold mb-2">Formación continua</h4>
          <p class="text-sm text-text-muted mb-3">Siempre aprendiendo nuevas tecnologías y mejores prácticas.</p>
          <div class="flex flex-wrap gap-2">
            {['JavaScript', 'TypeScript', 'React', 'Node.js', 'Astro'].map((tech) => (
              <span class="px-2 py-1 bg-white/5 text-text-secondary text-xs rounded-md">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>