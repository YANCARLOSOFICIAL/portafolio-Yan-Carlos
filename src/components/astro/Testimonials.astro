---
const es = {
  tag: 'TESTIMONIOS',
  title: 'Lo que dicen',
};

const en = {
  tag: 'TESTIMONIALS',
  title: 'What they say',
};

const testimonials = [
  {
    name: 'María Rodríguez',
    roleEs: 'CEO, Tech Solutions',
    roleEn: 'CEO, Tech Solutions',
    contentEs: 'Excelente trabajo. Entregó el proyecto antes de lo esperado y con una calidad excepcional. Recomendado.',
    contentEn: 'Excellent work. Delivered the project ahead of schedule with exceptional quality. Highly recommended.',
  },
  {
    name: 'Juan Pérez',
    roleEs: 'CTO, Startup Innovadora',
    roleEn: 'CTO, Innovative Startup',
    contentEs: 'Gran profesional. Siempre abierto a sugerencias y con gran capacidad de resolución de problemas.',
    contentEn: 'Great professional. Always open to suggestions with strong problem-solving skills.',
  },
  {
    name: 'Laura Gómez',
    roleEs: 'Directora de Proyecto',
    roleEn: 'Project Director',
    contentEs: 'Comunicación excelente y código muy limpio. Fue un placer trabajar con él en nuestro proyecto.',
    contentEn: 'Excellent communication and very clean code. It was a pleasure working with him on our project.',
  },
];
---

<section id="testimonials" class="py-24 relative">
  <div class="absolute inset-0 pattern-grid-accent opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex items-start gap-6 mb-12">
      <span class="section-number">05</span>
      <div>
        <p class="section-tag" data-lang-content="es">{es.tag}</p>
        <p class="section-tag" data-lang-content="en">{en.tag}</p>
        <h2 class="section-title" data-lang-content="es">{es.title}</h2>
        <h2 class="section-title" data-lang-content="en">{en.title}</h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((testimonial) => (
        <div class="brutal-card p-6 group">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-accent/10 border-2 border-accent flex items-center justify-center flex-shrink-0">
              <span class="font-display text-accent font-bold text-lg">{testimonial.name.charAt(0)}</span>
            </div>
            <div>
              <h4 class="font-display text-text-primary font-bold uppercase tracking-wider text-sm">{testimonial.name}</h4>
              <p class="font-display text-text-muted text-xs uppercase tracking-wide" data-lang-content="es">{testimonial.roleEs}</p>
              <p class="font-display text-text-muted text-xs uppercase tracking-wide" data-lang-content="en">{testimonial.roleEn}</p>
            </div>
          </div>

          <div class="relative">
            <span class="font-display text-5xl text-accent leading-none opacity-30 absolute -top-2 -left-1 select-none">"</span>
            <p class="text-text-secondary leading-relaxed pl-5 font-sans" data-lang-content="es">{testimonial.contentEs}</p>
            <p class="text-text-secondary leading-relaxed pl-5 font-sans" data-lang-content="en">{testimonial.contentEn}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
