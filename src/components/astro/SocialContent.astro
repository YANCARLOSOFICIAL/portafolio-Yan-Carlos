---
import videos from '../../data/youtube-videos.json';

const es = {
  tag: 'CONTENIDO RECIENTE',
  title: 'Ideas que puedes probar hoy',
  description: 'Videos, herramientas y experimentos sobre IA y programación para pasar de la curiosidad a un proyecto funcionando.',
  follow: 'Visitar perfil',
  youtube: 'Videos y tutoriales',
  tiktok: 'Clips y contenido corto',
  instagram: 'El lado más personal',
  youtubeDesc: 'Contenido técnico, proyectos y aprendizajes de desarrollo.',
  tiktokDesc: 'Ideas rápidas, experimentos y momentos detrás del código.',
  instagramDesc: 'Actualizaciones, procesos y novedades de mi camino.',
};

const en = {
  tag: 'LATEST CONTENT',
  title: 'Ideas you can try today',
  description: 'Videos, tools and experiments about AI and programming to move from curiosity to a working project.',
  follow: 'Visit profile',
  youtube: 'Videos and tutorials',
  tiktok: 'Short-form content',
  instagram: 'The personal side',
  youtubeDesc: 'Technical content, projects and development lessons.',
  tiktokDesc: 'Quick ideas, experiments and moments behind the code.',
  instagramDesc: 'Updates, process and news from my journey.',
};

const channels = [
  {
    name: 'YouTube',
    handle: '@codigotecnologico10',
    url: 'https://youtube.com/@codigotecnologico10',
    titleEs: es.youtube,
    titleEn: en.youtube,
    descEs: es.youtubeDesc,
    descEn: en.youtubeDesc,
    color: 'text-[#ff6b6b]',
    mark: 'YT',
  },
  {
    name: 'TikTok',
    handle: '@yanmusic3oficial',
    url: 'https://www.tiktok.com/@yanmusic3oficial',
    titleEs: es.tiktok,
    titleEn: en.tiktok,
    descEs: es.tiktokDesc,
    descEn: en.tiktokDesc,
    color: 'text-[#7dd3fc]',
    mark: 'TT',
  },
  {
    name: 'Instagram',
    handle: '@yancarlos45_oficial',
    url: 'https://www.instagram.com/yancarlos45_oficial/',
    titleEs: es.instagram,
    titleEn: en.instagram,
    descEs: es.instagramDesc,
    descEn: en.instagramDesc,
    color: 'text-[#f6c177]',
    mark: 'IG',
  },
];

---

<section id="content" class="py-24 relative overflow-hidden">
  <div class="absolute inset-0 pattern-grid-accent opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="max-w-2xl mb-12">
      <p class="section-tag" data-lang-content="es">{es.tag}</p>
      <p class="section-tag" data-lang-content="en">{en.tag}</p>
      <h2 class="section-title mt-3" data-lang-content="es">{es.title}</h2>
      <h2 class="section-title mt-3" data-lang-content="en">{en.title}</h2>
      <p class="text-text-secondary text-lg leading-relaxed mt-5" data-lang-content="es">{es.description}</p>
      <p class="text-text-secondary text-lg leading-relaxed mt-5" data-lang-content="en">{en.description}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {channels.map((channel) => (
        <a
          href={channel.url}
          target="_blank"
          rel="noopener noreferrer"
          class="brutal-card group p-6 min-h-56 flex flex-col justify-between"
          aria-label={`${channel.name}: ${channel.handle}`}
        >
          <div class="flex items-start justify-between gap-4">
            <span class={`w-12 h-12 rounded-sm bg-surfaceHover border border-border flex items-center justify-center font-display text-sm font-bold ${channel.color}`}>
              {channel.mark}
            </span>
            <svg class="w-5 h-5 text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <div class="mt-8">
            <p class="font-display text-xs uppercase tracking-widest text-text-muted">{channel.name} · {channel.handle}</p>
            <h3 class="font-sans text-xl font-semibold text-text-primary mt-2 group-hover:text-accent transition-colors">
              <span data-lang-content="es">{channel.titleEs}</span>
              <span data-lang-content="en">{channel.titleEn}</span>
            </h3>
            <p class="text-text-secondary text-sm leading-relaxed mt-2">
              <span data-lang-content="es">{channel.descEs}</span>
              <span data-lang-content="en">{channel.descEn}</span>
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
        <div>
          <p class="font-display text-xs uppercase tracking-widest text-accent">YouTube</p>
          <h3 class="font-sans text-2xl font-semibold text-text-primary mt-2">
            <span data-lang-content="es">Videos destacados</span>
            <span data-lang-content="en">Featured videos</span>
          </h3>
        </div>
        <a
          href="https://youtube.com/@codigotecnologico10"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brutal-outline self-start sm:self-auto"
        >
          <span data-lang-content="es">Ver canal</span>
          <span data-lang-content="en">View channel</span>
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {videos.map((video) => (
          <article class="brutal-card overflow-hidden">
            <div class="aspect-video bg-background">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${video.id}?rel=0`}
                title={video.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <div class="p-5">
              <p class="font-sans font-medium text-text-primary">{video.title}</p>
              <a
                href={`https://www.youtube.com/watch?v=${video.id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 mt-3 text-accent font-display text-xs uppercase tracking-wider hover:text-accentLight transition-colors"
              >
                YouTube
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
