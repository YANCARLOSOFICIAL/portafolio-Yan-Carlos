---
const es = {
  tag: 'HABILIDADES',
  title: 'Tecnologías',
};

const en = {
  tag: 'SKILLS',
  title: 'Technologies',
};

const categories = [
  { nameEs: 'Frontend', nameEn: 'Frontend', accent: 'cyber', items: ['React', 'Vue', 'Astro', 'TypeScript', 'Tailwind'] },
  { nameEs: 'Backend', nameEn: 'Backend', accent: 'accent', items: ['Node.js', 'Laravel', 'Express', 'GraphQL', 'REST APIs'] },
  { nameEs: 'Base de Datos', nameEn: 'Database', accent: 'alert', items: ['PostgreSQL', 'MongoDB'] },
  { nameEs: 'DevOps', nameEn: 'DevOps', accent: 'depth', items: ['Docker', 'AWS', 'Git'] },
];

const colorMap: Record<string, string> = {
  cyber: 'bg-cyber',
  accent: 'bg-accent',
  alert: 'bg-alert',
  depth: 'bg-depth',
};

const textMap: Record<string, string> = {
  cyber: 'text-cyber',
  accent: 'text-accent',
  alert: 'text-alert',
  depth: 'text-depth',
};
---

<section id="skills" class="py-24 relative">
  <div class="absolute inset-0 pattern-grid-accent opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex items-start gap-6 mb-12">
      <span class="section-number">04</span>
      <div>
        <p class="section-tag" data-lang-content="es">{es.tag}</p>
        <p class="section-tag" data-lang-content="en">{en.tag}</p>
        <h2 class="section-title" data-lang-content="es">{es.title}</h2>
        <h2 class="section-title" data-lang-content="en">{en.title}</h2>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map((category) => (
        <div class="brutal-card p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class={`w-3 h-3 ${colorMap[category.accent] || 'bg-accent'}`}></span>
            <h3 class={`font-display text-sm font-bold uppercase tracking-wider ${textMap[category.accent] || 'text-accent'}`}>
              <span data-lang-content="es">{category.nameEs}</span>
              <span data-lang-content="en">{category.nameEn}</span>
            </h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {category.items.map((tech) => (
              <span class="px-3 py-1.5 bg-transparent border-2 border-border text-text-secondary
                           font-display text-xs tracking-wide
                           hover:border-accent hover:text-accent
                           transition-colors duration-200 cursor-default">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
