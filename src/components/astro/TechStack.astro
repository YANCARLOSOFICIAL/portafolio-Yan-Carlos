---
import { siteConfig } from '../../config/siteConfig';

const { skills, hero } = siteConfig;
---

<section id="skills" class="py-24 relative">
  <div class="dot-pattern absolute inset-0 opacity-20 pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12">
      <p class="text-purple-400 text-sm font-mono tracking-wider uppercase mb-2">{skills.tag}</p>
      <h2 class="text-3xl md:text-5xl font-extrabold text-white">{skills.title}</h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 hover:border-purple-500/30 transition-colors">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
          <h3 class="text-sm font-semibold text-blue-400 uppercase tracking-wider">Frontend</h3>
        </div>
        <div class="flex flex-wrap gap-2">
          {['React', 'Vue', 'Astro', 'TypeScript', 'Tailwind'].map((tech) => (
            <span class="px-3 py-1.5 bg-white/5 text-gray-300 text-sm rounded-lg font-mono border border-white/5 hover:border-blue-500/50 hover:text-white transition-colors cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 hover:border-purple-500/30 transition-colors">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-green-500 rounded-full"></span>
          <h3 class="text-sm font-semibold text-green-400 uppercase tracking-wider">Backend</h3>
        </div>
        <div class="flex flex-wrap gap-2">
          {['Node.js', 'Laravel', 'Express', 'GraphQL', 'REST APIs'].map((tech) => (
            <span class="px-3 py-1.5 bg-white/5 text-gray-300 text-sm rounded-lg font-mono border border-white/5 hover:border-green-500/50 hover:text-white transition-colors cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 hover:border-purple-500/30 transition-colors">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-yellow-500 rounded-full"></span>
          <h3 class="text-sm font-semibold text-yellow-400 uppercase tracking-wider">Database</h3>
        </div>
        <div class="flex flex-wrap gap-2">
          {['PostgreSQL', 'MongoDB'].map((tech) => (
            <span class="px-3 py-1.5 bg-white/5 text-gray-300 text-sm rounded-lg font-mono border border-white/5 hover:border-yellow-500/50 hover:text-white transition-colors cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 hover:border-purple-500/30 transition-colors">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
          <h3 class="text-sm font-semibold text-orange-400 uppercase tracking-wider">DevOps</h3>
        </div>
        <div class="flex flex-wrap gap-2">
          {['Docker', 'AWS', 'Git'].map((tech) => (
            <span class="px-3 py-1.5 bg-white/5 text-gray-300 text-sm rounded-lg font-mono border border-white/5 hover:border-orange-500/50 hover:text-white transition-colors cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>