---
const metrics = [
  { value: '500+', label: 'Empresas atendidas' },
  { value: '10+', label: 'Proyectos completados' },
  { value: '30%', label: 'Reducción en facturación' },
];

const frontendItems = [
  'UI/UX moderno y accesible',
  'React, Astro, animaciones',
  'Diseño responsive mobile-first',
  'Performance y SEO optimizado',
];

const backendItems = [
  'APIs robustas (REST, GraphQL)',
  'Node.js, bases de datos SQL/NoSQL',
  'Autenticación y escalabilidad',
  'DevOps, CI/CD y cloud',
];
---

<section id="about" class="py-24 relative">
  <div class="absolute inset-0 pattern-dots opacity-30"></div>
  <div class="absolute top-0 right-0 w-64 h-64 bg-neon-purple/10 rounded-full blur-[100px]"></div>
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="mb-10">
      <p class="section-title">SOBRE MÍ</p>
      <h2 class="section-heading">Construyendo el futuro</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div class="space-y-6">
        <p class="text-lg text-text-secondary leading-relaxed">
          Soy <span class="text-neon-purple font-semibold">Yan Carlos Guerra</span>, estudiante de Ingeniería en Sistemas con +1 año de experiencia en desarrollo full-stack. Me especializo en crear soluciones tecnológicas que generan resultados medibles.
        </p>
        <p class="text-text-secondary leading-relaxed">
          En <span class="text-neon-cyan font-semibold">Kamila Innovation S.A.S</span>, participé en el desarrollo de sistemas que sirven a más de 500 empresas. Me apasiona aprender nuevas tecnologías y adaptarme rápidamente a los requerimientos del equipo.
        </p>
      </div>

      <div class="grid grid-cols-3 gap-4">
        {metrics.map((metric) => (
          <div class="metric-card group">
            <p class="text-3xl font-bold text-gradient group-hover:scale-110 transition-transform">{metric.value}</p>
            <p class="text-text-muted text-xs mt-1">{metric.label}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mt-12">
      <div class="glass-hover rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-neon-cyan rounded-full"></span>
          Frontend
        </h3>
        <ul class="space-y-3">
          {frontendItems.map((item) => (
            <li class="flex items-center gap-2 text-text-secondary">
              <svg class="w-4 h-4 text-neon-cyan flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="glass-hover rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-neon-pink rounded-full"></span>
          Backend
        </h3>
        <ul class="space-y-3">
          {backendItems.map((item) => (
            <li class="flex items-center gap-2 text-text-secondary">
              <svg class="w-4 h-4 text-neon-pink flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>