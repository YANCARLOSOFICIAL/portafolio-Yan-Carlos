---
const positions = [
  {
    title: 'Full-stack Developer',
    company: 'Kamila Innovation S.A.S',
    location: 'Sibundoy, Putumayo, Colombia',
    type: 'Remoto',
    period: 'Marzo 2025 - Actualidad',
    duration: '11 meses',
    description: [
      'Desarrollo de aplicaciones web con Laravel y Vue',
      'Implementación de APIs RESTful',
      'Integración con sistemas de facturación electrónica y ecommerce',
    ],
    skills: ['Laravel', 'Vue.js', 'APIs REST', 'Full Stack'],
    achievements: [
      { value: '500+', label: 'Empresas' },
      { value: '30%', label: 'Reducción' },
      { value: '10+', label: 'Proyectos' },
    ],
  },
];
---

<section id="experience" class="py-24 relative">
  <div class="absolute inset-0 pattern-dots opacity-30"></div>
  <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-neon-pink/10 rounded-full blur-[100px]"></div>
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="mb-10">
      <p class="section-title">EXPERIENCIA</p>
      <h2 class="section-heading">Trayectoria profesional</h2>
    </div>

    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-neon-purple via-neon-purple/50 to-transparent"></div>

      {positions.map((position, index) => (
        <div class={`relative flex items-center mb-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
          <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-neon-purple rounded-full transform -translate-x-1/2 z-10 ring-4 ring-background"></div>
          
          <div class="ml-12 md:ml-0 md:w-1/2 md:px-8">
            <div class="glass-hover rounded-2xl p-6 group">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class="px-3 py-1 bg-neon-purple/20 text-neon-purpleLight text-xs rounded-full font-mono border border-neon-purple/30">
                  {position.duration}
                </span>
                <span class="text-xs text-text-muted">{position.type}</span>
              </div>

              <h3 class="text-xl font-bold text-white mb-1 group-hover:text-neon-purple transition-colors">{position.title}</h3>
              <p class="text-neon-cyan font-medium mb-2">{position.company}</p>
              <p class="text-text-muted text-sm mb-4">{position.location}</p>

              <ul class="space-y-2 mb-4">
                {position.description.map((desc) => (
                  <li class="flex items-start gap-2 text-text-secondary text-sm">
                    <span class="w-1.5 h-1.5 bg-neon-purple rounded-full mt-1.5 flex-shrink-0"></span>
                    {desc}
                  </li>
                ))}
              </ul>

              {position.achievements && (
                <div class="pt-4 border-t border-white/5">
                  <p class="text-xs text-text-muted uppercase tracking-wider mb-3">Logros</p>
                  <div class="grid grid-cols-3 gap-2">
                    {position.achievements.map((achievement) => (
                      <div class="text-center p-2 bg-neon-purple/10 rounded-lg border border-neon-purple/20">
                        <p class="text-lg font-bold text-neon-purple">{achievement.value}</p>
                        <p class="text-xs text-text-muted">{achievement.label}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <div class="flex flex-wrap gap-2 mt-4">
                {position.skills.map((skill) => (
                  <span class="px-2 py-1 bg-white/5 text-text-secondary text-xs rounded-md font-mono border border-white/5">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>