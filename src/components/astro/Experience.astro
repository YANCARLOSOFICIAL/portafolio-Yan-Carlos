---
const es = {
  tag: 'EXPERIENCIA',
  title: 'Trayectoria profesional',
  logros: 'Logros',
  position: {
    title: 'Full-stack Developer',
    company: 'Kamila Innovation S.A.S',
    location: 'Sibundoy, Putumayo, Colombia',
    type: 'Remoto',
    duration: '11 meses',
    period: 'Marzo 2025 - Actualidad',
    desc1: 'Desarrollo de aplicaciones web con Laravel y Vue',
    desc2: 'Implementación de APIs RESTful',
    desc3: 'Integración con sistemas de facturación electrónica y ecommerce',
    achievements: [
      { value: '500+', label: 'Empresas' },
      { value: '30%', label: 'Reducción' },
      { value: '10+', label: 'Proyectos' },
    ],
    skills: ['Laravel', 'Vue.js', 'APIs REST', 'Full Stack'],
  },
};

const en = {
  tag: 'EXPERIENCE',
  title: 'Professional journey',
  logros: 'Achievements',
  position: {
    title: 'Full-stack Developer',
    company: 'Kamila Innovation S.A.S',
    location: 'Sibundoy, Putumayo, Colombia',
    type: 'Remote',
    duration: '11 months',
    period: 'March 2025 - Present',
    desc1: 'Web application development with Laravel and Vue',
    desc2: 'RESTful API implementation',
    desc3: 'Integration with electronic invoicing and ecommerce systems',
    achievements: [
      { value: '500+', label: 'Companies' },
      { value: '30%', label: 'Reduction' },
      { value: '10+', label: 'Projects' },
    ],
    skills: ['Laravel', 'Vue.js', 'REST APIs', 'Full Stack'],
  },
};
---

<section id="experience" class="py-24 relative">
  <div class="absolute inset-0 pattern-grid-accent opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex items-start gap-6 mb-12">
      <span class="section-number">02</span>
      <div>
        <p class="section-tag" data-lang-content="es">{es.tag}</p>
        <p class="section-tag" data-lang-content="en">{en.tag}</p>
        <h2 class="section-title" data-lang-content="es">{es.title}</h2>
        <h2 class="section-title" data-lang-content="en">{en.title}</h2>
      </div>
    </div>

    <div class="relative">
      <div class="absolute left-4 md:left-12 top-0 bottom-0 w-0.5 bg-accent"></div>

      <div class="relative flex items-start mb-8">
        <div class="absolute left-4 md:left-12 w-4 h-4 bg-accent transform -translate-x-1/2 z-10 border-2 border-background"></div>

        <div class="ml-12 md:ml-24 w-full">
          <div class="brutal-card p-6 group">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-accent/10 border-2 border-accent text-accent font-display text-xs uppercase tracking-wider">
                <span data-lang-content="es">{es.position.duration}</span>
                <span data-lang-content="en">{en.position.duration}</span>
              </span>
              <span class="font-display text-text-muted text-xs uppercase tracking-wider">
                <span data-lang-content="es">{es.position.type}</span>
                <span data-lang-content="en">{en.position.type}</span>
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-text-primary mb-1 group-hover:text-accent transition-colors">{es.position.title}</h3>
            <p class="font-display text-cyber font-bold text-sm uppercase tracking-wider mb-2">{es.position.company}</p>
            <p class="font-display text-text-muted text-xs uppercase tracking-wide mb-4">{es.position.location}</p>

            <ul class="space-y-2 mb-4">
              <li class="flex items-start gap-2 text-text-secondary text-sm font-sans">
                <span class="w-2 h-2 bg-accent mt-1.5 flex-shrink-0"></span>
                <span data-lang-content="es">{es.position.desc1}</span>
                <span data-lang-content="en">{en.position.desc1}</span>
              </li>
              <li class="flex items-start gap-2 text-text-secondary text-sm font-sans">
                <span class="w-2 h-2 bg-accent mt-1.5 flex-shrink-0"></span>
                <span data-lang-content="es">{es.position.desc2}</span>
                <span data-lang-content="en">{en.position.desc2}</span>
              </li>
              <li class="flex items-start gap-2 text-text-secondary text-sm font-sans">
                <span class="w-2 h-2 bg-accent mt-1.5 flex-shrink-0"></span>
                <span data-lang-content="es">{es.position.desc3}</span>
                <span data-lang-content="en">{en.position.desc3}</span>
              </li>
            </ul>

            <div class="pt-4 border-t-2 border-border">
              <p class="font-display text-text-muted text-xs uppercase tracking-wider mb-3" data-lang-content="es">{es.logros}</p>
              <p class="font-display text-text-muted text-xs uppercase tracking-wider mb-3" data-lang-content="en">{en.logros}</p>
              <div class="grid grid-cols-3 gap-2">
                {es.position.achievements.map((achievement) => (
                  <div class="text-center p-3 bg-background border-2 border-border">
                    <p class="font-display text-lg font-bold text-accent">{achievement.value}</p>
                    <p class="font-display text-text-muted text-xs uppercase tracking-wider">{achievement.label}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex flex-wrap gap-2 mt-4">
              {es.position.skills.map((skill) => (
                <span class="tech-badge text-xs">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
