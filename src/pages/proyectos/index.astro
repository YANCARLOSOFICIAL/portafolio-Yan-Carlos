---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import App from '../../components/react/App';
import Footer from '../../components/astro/Footer.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured)
);

const catStyle: Record<string, string> = {
  fullstack: 'bg-accent text-background border-accent',
  frontend: 'bg-cyber text-background border-cyber',
  backend: 'bg-depth text-background border-depth',
  ai: 'bg-alert text-background border-alert',
};

const es = {
  breadcrumb: '~/proyectos',
  tag: '// git remote -v',
  title: 'Proyectos',
  subtitle:
    'Cada proyecto con su repositorio: clónalo, rompelo y despliégalo. Fichas técnicas con README y stack real.',
  open: 'abrir ficha →',
  repo: 'repo',
};
const en = {
  breadcrumb: '~/proyectos',
  tag: '// git remote -v',
  title: 'Projects',
  subtitle:
    'Every project with its repository: clone it, break it and deploy it. Tech sheets with real README and stack.',
  open: 'open sheet →',
  repo: 'repo',
};
---

<BaseLayout
  title="Proyectos — Código Tecnológico"
  description="Proyectos fullstack, frontend, backend e IA con su repositorio público: chatbot RAG, e-commerce microservicios, API de facturas y más."
>
  <App client:load />

  <main class="pt-16 pattern-grid min-h-screen">
    <header class="border-b border-border bg-background/80 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-6 py-14 md:py-20">
        <p class="font-mono text-xs text-text-muted mb-6" data-lang-content="es">$ cd {es.breadcrumb}</p>
        <p class="font-mono text-xs text-text-muted mb-6" data-lang-content="en">$ cd {en.breadcrumb}</p>

        <span class="section-tag" data-lang-content="es">// {es.tag}</span>
        <span class="section-tag" data-lang-content="en">// {en.tag}</span>

        <h1 class="section-title mt-3" data-lang-content="es">{es.title}</h1>
        <h1 class="section-title mt-3" data-lang-content="en">{en.title}</h1>

        <p class="mt-4 text-text-secondary max-w-2xl" data-lang-content="es">{es.subtitle}</p>
        <p class="mt-4 text-text-secondary max-w-2xl" data-lang-content="en">{en.subtitle}</p>
      </div>
    </header>

    <section class="max-w-6xl mx-auto px-6 py-10 md:py-14">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) =>
          project.data.demoOnly ? (
            // Sin ficha ni repo: solo la demo
            <a
              href={project.data.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="brutal-card group flex flex-col"
            >
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class={`px-2.5 py-1 rounded-full text-xs font-display uppercase tracking-wider border ${catStyle[project.data.category]}`}>
                    {project.data.category === 'ai' ? 'AI' : project.data.category}
                  </span>
                  <span class="font-mono text-xs text-text-muted">demo ↗</span>
                </div>

                <h2 class="font-display text-lg font-bold text-text-primary mb-2 group-hover:text-accent transition-colors">
                  {project.data.title}
                </h2>
                <p class="text-text-secondary text-sm mb-4 leading-relaxed font-sans flex-1">
                  {project.data.description}
                </p>

                <div class="flex flex-wrap gap-2 mb-4">
                  {project.data.tech.slice(0, 5).map((tech) => (
                    <span class="tech-badge text-xs">{tech}</span>
                  ))}
                </div>

                <span class="font-display text-xs uppercase tracking-widest text-accent mt-auto">
                  <span data-lang-content="es">ver demo ↗</span>
                  <span data-lang-content="en">view demo ↗</span>
                </span>
              </div>
            </a>
          ) : (
            <a href={`/proyectos/${project.id}`} class="brutal-card group flex flex-col">
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class={`px-2.5 py-1 rounded-full text-xs font-display uppercase tracking-wider border ${catStyle[project.data.category]}`}>
                    {project.data.category === 'ai' ? 'AI' : project.data.category}
                  </span>
                  <span class="font-mono text-xs text-text-muted truncate max-w-[55%]" title={project.data.github}>
                    {project.data.github.replace('https://github.com/', '')}
                  </span>
                </div>

                <h2 class="font-display text-lg font-bold text-text-primary mb-2 group-hover:text-accent transition-colors">
                  {project.data.title}
                </h2>
                <p class="text-text-secondary text-sm mb-4 leading-relaxed font-sans flex-1">
                  {project.data.description}
                </p>

                <div class="flex flex-wrap gap-2 mb-4">
                  {project.data.tech.slice(0, 5).map((tech) => (
                    <span class="tech-badge text-xs">{tech}</span>
                  ))}
                </div>

                <span class="font-display text-xs uppercase tracking-widest text-text-muted group-hover:text-accent transition-colors mt-auto">
                  <span data-lang-content="es">{es.open}</span>
                  <span data-lang-content="en">{en.open}</span>
                </span>
              </div>
            </a>
          )
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
