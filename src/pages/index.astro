---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/react/App';
import Footer from '../components/astro/Footer.astro';
import SocialContent from '../components/astro/SocialContent.astro';
import CreatorHero from '../components/astro/CreatorHero.astro';
import CreatorAbout from '../components/astro/CreatorAbout.astro';
import CreatorEditorial from '../components/astro/CreatorEditorial.astro';
import ContentSections from '../components/react/ContentSections';
---

<BaseLayout title="Código Tecnológico — IA, programación y herramientas" description="Yan Carlos Guerra comparte contenido sobre inteligencia artificial, programación y herramientas para construir proyectos reales.">
  <App client:load />
  <main>
    <CreatorHero />
    <CreatorEditorial />
    <CreatorAbout />
    <SocialContent />
    <ContentSections client:load />
  </main>
  <Footer />

  <style is:global>
    html {
      scroll-behavior: smooth;
    }
  </style>
</BaseLayout>
