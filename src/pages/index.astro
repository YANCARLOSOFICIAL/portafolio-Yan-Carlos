---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/react/App';
import About from '../components/astro/About.astro';
import Experience from '../components/astro/Experience.astro';
import TechStack from '../components/astro/TechStack.astro';
import Testimonials from '../components/astro/Testimonials.astro';
import Education from '../components/astro/Education.astro';
import Footer from '../components/astro/Footer.astro';
---

<BaseLayout title="Yan Carlos Guerra - Full Stack Developer" description="Estudiante de Ingeniería en Sistemas con +1 año de experiencia en producción. Full Stack Developer especializado en React, Node.js, Laravel.">
  <App client:load />
  <About />
  <Experience />
  <TechStack />
  <Testimonials />
  <Education />
  <Footer />

  <style is:global>
    html {
      scroll-behavior: smooth;
    }
  </style>
</BaseLayout>
