---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/react/App';
import About from '../components/astro/About.astro';
import Experience from '../components/astro/Experience.astro';
import TechStack from '../components/astro/TechStack.astro';
import Testimonials from '../components/astro/Testimonials.astro';
import Education from '../components/astro/Education.astro';
import Footer from '../components/astro/Footer.astro';
---

<BaseLayout title="Yan Carlos Guerra - Full Stack Developer" description="10th semester student with +1 year of experience in production.">
  <App client:load />
  
  <About />
  <Experience />
  <TechStack />
  <Testimonials />
  <Education />
  
  <Footer />
  
  <style is:global>
    html {
      scroll-behavior: smooth;
    }
  </style>
</BaseLayout>