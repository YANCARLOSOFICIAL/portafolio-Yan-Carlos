---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/react/App';
import Footer from '../components/astro/Footer.astro';
import SocialContent from '../components/astro/SocialContent.astro';
import BlogTeaser from '../components/astro/BlogTeaser.astro';
import CreatorHero from '../components/astro/CreatorHero.astro';
import CreatorAbout from '../components/astro/CreatorAbout.astro';
import CreatorEditorial from '../components/astro/CreatorEditorial.astro';
import ContentSections from '../components/react/ContentSections';

// Fuente única de proyectos: colección en src/content/projects/
const projects = (await getCollection('projects')).map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  descriptionEn: p.data.descriptionEn,
  tech: p.data.tech,
  category: p.data.category,
  demo: p.data.demo ?? p.data.github,
  // demoOnly: no se expone el repositorio en ningún punto (solo la demo)
  github: p.data.demoOnly ? '' : p.data.github,
  demoOnly: p.data.demoOnly,
}));
---

<BaseLayout title="Código Tecnológico — IA, programación y herramientas" description="Yan Carlos Guerra comparte contenido sobre inteligencia artificial, programación y herramientas para construir proyectos reales.">
  <App client:load />
  <main>
    <CreatorHero />
    <CreatorEditorial />
    <CreatorAbout />
    <SocialContent />
    <BlogTeaser />
    <ContentSections client:load projects={projects} />
  </main>
  <Footer />

  <style is:global>
    html {
      scroll-behavior: smooth;
    }
  </style>
</BaseLayout>
